{
  "name": "gravity-monorepo",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm run dev -w apps/extension",
    "build:extension": "npm run build -w apps/extension",
    "backup": "powershell -ExecutionPolicy Bypass -File ./scripts/backup.ps1"
  },
  "devDependencies": {
    "typescript": "^5.0.2"
  }
}
