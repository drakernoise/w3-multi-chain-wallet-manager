{
  "manifest_version": 3,
  "name": "Gravity Wallet",
  "version": "1.1.2",
  "description": "Secure wallet for Blurt, Hive, and Steem with dApp signing, multisig, chat, and device sync.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Gravity Wallet",
    "default_icon": {
      "16": "logowallet.png",
      "48": "logowallet.png",
      "128": "logowallet.png"
    }
  },
  "icons": {
    "16": "logowallet.png",
    "48": "logowallet.png",
    "128": "logowallet.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "windows",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://peakd.com/*",
        "https://ecency.com/*",
        "https://hive.blog/*",
        "https://wallet.hive.blog/*",
        "https://tribaldex.com/*",
        "https://*.tribaldex.com/*",
        "https://hive-engine.com/*",
        "https://*.hive-engine.com/*",
        "https://splinterlands.com/*",
        "https://peakmonsters.com/*",
        "https://inleo.io/*",
        "https://3speak.tv/*",
        "https://blurt.blog/*",
        "https://twiggy.lat/*",
        "https://blurtwallet.com/*",
        "https://*.blurtwallet.com/*",
        "https://blurtplugin.online/*",
        "https://forum.blurt.pl/*",
        "https://beblurt.com/*",
        "https://blurt.one/*",
        "https://steemitwallet.com/*",
        "https://steemworld.org/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://peakd.com/*",
        "https://ecency.com/*",
        "https://hive.blog/*",
        "https://wallet.hive.blog/*",
        "https://tribaldex.com/*",
        "https://*.tribaldex.com/*",
        "https://hive-engine.com/*",
        "https://*.hive-engine.com/*",
        "https://splinterlands.com/*",
        "https://peakmonsters.com/*",
        "https://inleo.io/*",
        "https://3speak.tv/*",
        "https://blurt.blog/*",
        "https://twiggy.lat/*",
        "https://blurtwallet.com/*",
        "https://*.blurtwallet.com/*",
        "https://blurtplugin.online/*",
        "https://forum.blurt.pl/*",
        "https://beblurt.com/*",
        "https://blurt.one/*",
        "https://steemitwallet.com/*",
        "https://steemworld.org/*"
      ],
      "js": [
        "assets/provider.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/provider.js"
      ],
      "matches": [
        "https://peakd.com/*",
        "https://ecency.com/*",
        "https://hive.blog/*",
        "https://wallet.hive.blog/*",
        "https://tribaldex.com/*",
        "https://*.tribaldex.com/*",
        "https://hive-engine.com/*",
        "https://*.hive-engine.com/*",
        "https://splinterlands.com/*",
        "https://peakmonsters.com/*",
        "https://inleo.io/*",
        "https://3speak.tv/*",
        "https://blurt.blog/*",
        "https://twiggy.lat/*",
        "https://blurtwallet.com/*",
        "https://*.blurtwallet.com/*",
        "https://blurtplugin.online/*",
        "https://forum.blurt.pl/*",
        "https://beblurt.com/*",
        "https://blurt.one/*",
        "https://steemitwallet.com/*",
        "https://steemworld.org/*"
      ]
    }
  ],
  "host_permissions": [
    "https://peakd.com/*",
    "https://ecency.com/*",
    "https://hive.blog/*",
    "https://wallet.hive.blog/*",
    "https://tribaldex.com/*",
    "https://*.tribaldex.com/*",
    "https://hive-engine.com/*",
    "https://*.hive-engine.com/*",
    "https://splinterlands.com/*",
    "https://peakmonsters.com/*",
    "https://inleo.io/*",
    "https://3speak.tv/*",
    "https://blurt.blog/*",
    "https://twiggy.lat/*",
    "https://blurtwallet.com/*",
    "https://*.blurtwallet.com/*",
    "https://blurtplugin.online/*",
    "https://forum.blurt.pl/*",
    "https://beblurt.com/*",
    "https://blurt.one/*",
    "https://steemitwallet.com/*",
    "https://steemworld.org/*",
    "https://api.hive.blog/*",
    "https://api.openhive.network/*",
    "https://anyx.io/*",
    "https://hive-api.arcange.eu/*",
    "https://api.deathwing.me/*",
    "https://techcoderx.com/*",
    "https://api.steemit.com/*",
    "https://api.steem.fans/*",
    "https://api.steememory.com/*",
    "https://rpc.drakernoise.com/*",
    "https://blurt-rpc.saboin.com/*",
    "https://rpc.mahdiyari.info/*",
    "https://hive-api.3speak.tv/*",
    "https://api.justyy.com/*",
    "https://api.blurt.blog/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://chat.gravitywallet.drakernoise.com wss://chat.gravitywallet.drakernoise.com https://api.hive.blog https://api.openhive.network https://anyx.io https://hive-api.arcange.eu https://api.deathwing.me https://techcoderx.com https://api.steemit.com https://api.steem.fans https://api.steememory.com https://rpc.drakernoise.com https://blurt-rpc.saboin.com https://rpc.mahdiyari.info https://hive-api.3speak.tv https://api.justyy.com https://api.blurt.blog"
  }
}
