{
    "name": "gravity-extension",
    "private": true,
    "version": "1.1.2",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build && node ../../scripts/patch-dist.cjs",
        "build:chrome": "npm run build && node ../../scripts/patch-manifest.cjs chrome",
        "build:firefox": "npm run build && node ../../scripts/patch-manifest.cjs firefox",
        "build:edge": "npm run build:chrome",
        "preview": "vite preview"
    },
    "dependencies": {
        "gravity-shared": "*",
        "@blurtfoundation/blurtjs": "^1.0.0",
        "@google/generative-ai": "^0.24.1",
        "@hiveio/dhive": "^1.2.8",
        "@hiveio/hive-js": "^2.0.9",
        "@types/qrcode": "^1.5.6",
        "buffer": "^6.0.3",
        "dsteem": "^0.11.3",
        "hive-tx": "^7.0.0",
        "otplib": "^12.0.1",
        "process": "^0.11.10",
        "qrcode": "^1.5.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.14",
        "postcss": "^8.4.24",
        "tailwindcss": "^3.3.2",
        "typescript": "^5.0.2",
        "vite": "^7.2.7",
        "vite-plugin-node-polyfills": "^0.25.0"
    }
}